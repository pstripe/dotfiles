{
  "mcp": {
    "semble": {
      "command": [ "semble" ],
      "type": "local",
      "enabled": true
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "gopls":{
      "command": ["gopls", "-remote=auto"],
      "extensions": [".go"],
      "disabled": false,
    }
  },
  "formatter": {
    "md": {
      "command": [
        "deno",
        "fmt",
        "$FILE"
      ],
      "extensions": [
        ".md"
      ]
    }
  },
  "instructions": [
    "rules/cli_tools.md", // rg, fd
    "rules/semble.md", // semantic search
  ],
  "plugin": [
    "tools/ponytail/.opencode/plugins/ponytail.mjs",
  ],
}
